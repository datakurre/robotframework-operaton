      <bpmn:script>var nimeamispaatos_tiedosto_nimi = "Nimeämispäätös; ".concat(nimeamispyynto_nimi).concat(".pdf");

var old = execution.getVariableTyped("pdf_generoitu");

org.camunda.bpm.engine.variable.Variables.fileValue(nimeamispaatos_tiedosto_nimi).file(old.getValue()).mimeType(old.getMimeType()).create()</bpmn:script>
